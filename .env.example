# === Optional: API key fallbacks, one per provider ===
# Only used while that provider's key box in Settings > AI is empty (owner and members who
# inherit Models; never a member with its own Models).
# Most users should set their LLM key in the dashboard instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# === Optional: Claude Code (uses Max/Pro subscription instead of API credits) ===
# Generate with: claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# === Optional: OpenCode Go (subscription, OpenAI-compatible endpoint) ===
# Prefer the Settings > AI field; this is for a headless deploy.
# OPENCODE_API_KEY=

# === Optional: Telegram Notifications (get token from @BotFather) ===
# TELEGRAM_BOT_TOKEN=

# === Optional: Gmail Monitoring (one-time OAuth2 setup) ===
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# Optional, owner only: accounts connect their mailbox in Settings (add
# <dashboard>/api/gmail/callback as a redirect URI); this token is the owner's fallback.
# GMAIL_REFRESH_TOKEN=

# === Optional: LM Studio / Ollama (local inference, runs on the host outside the container) ===
# Used while the Settings › Models address is empty (the default); an address typed there wins.
# Docker Desktop (Mac/Windows): host.docker.internal reaches the host as-is.
# Linux: add `extra_hosts: ["host.docker.internal:host-gateway"]` to the backend service first.
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Optional: single sign-on with OIDC (Authentik, Keycloak, ...) ===
# Create an OAuth2/OpenID provider + application in the provider with the redirect URI
#   <your dashboard URL>/api/auth/oidc/callback
# Each value can also be set (and wins) in Settings > Advanced. The install password stays as
# a break-glass login. The first login with OIDC_OWNER_EMAIL becomes the owner; everyone else
# becomes a member (up to 5 accounts) with their own LLM/LinkedIn/Jobright/Apify credentials.
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/jobnavigator/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_OWNER_EMAIL=you@example.com
# OIDC_PUBLIC_URL=https://jobs.example.com
# OIDC_TRUST_EMAIL=true      # Authentik reports emails unverified by default; true lets the owner email link anyway
# OIDC_ALLOWED_GROUPS=
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Authentik

# === Database (defaults work with docker-compose) ===
DATABASE_URL=postgresql://jobnavigator:password@db:5432/jobnavigator

# === Dashboard Password (empty = no auth on first run) ===
# INITIAL_API_KEY=

# === Optional: pin the prebuilt images to a release (default latest) ===
# JN_IMAGE_TAG=3.0

# One time zone for crons, day buckets, the DB session and the UI (backend/tz.py)
TZ=America/New_York
# SearXNG (daily curator search) — any long random string
SEARXNG_SECRET=
# === Optional: Telemetry (README > Telemetry) ===
# The owner chooses Yes or Essentials in the app; this overrides it and locks the choice.
# off = nothing is ever sent. Values: off | essentials | full
# JN_TELEMETRY=off
