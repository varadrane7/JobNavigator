<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- CV</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 14mm 16mm 13mm 16mm;
}

html, body {
  font-family: 'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 10pt;
  line-height: 1.3;
  color: #1c1c1c;
  background: #fff;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 14mm 16mm 13mm 16mm;
  margin: 0 auto;
}

/* The preview uses the wrapper padding. Printed pages use the @page margins (same
   values), so every continuation page keeps the same whitespace. */
@media print {
  .page { width: auto; padding: 0; margin: 0; }
}

a { color: inherit; text-decoration: none; }

/* --- Header: name, contact line, then a details line for "Label: value" items
   (nationality, work authorization, availability) that European recruiters screen on --- */
.header { margin-bottom: 7pt; }

.header h1 {
  font-size: 20pt;
  font-weight: 700;
  letter-spacing: 0.2px;
  line-height: 1.05;
  color: #12263f;
}

.header .title-line {
  font-size: 11pt;
  color: #3a4a5c;
  margin-top: 1pt;
}

.header .contact,
.header .details {
  font-size: 9.5pt;
  color: #2b2b2b;
  margin-top: 3pt;
}

.header .details { margin-top: 1.5pt; }
.header .details b { font-weight: 600; color: #12263f; }
.header .sep { margin: 0 5pt; color: #8a94a0; }
.header .ci { white-space: nowrap; }

/* --- Section --- */
.section { margin-top: 8pt; }

.section-title {
  font-size: 10.5pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  color: #12263f;
  border-bottom: 0.8pt solid #12263f;
  padding-bottom: 1.5pt;
  margin-bottom: 4pt;
  break-after: avoid;
  page-break-after: avoid;
}

.summary-text { text-align: left; }

/* --- Entries: role (or degree) and dates on one row, organisation and place below --- */
.entry { margin-bottom: 6pt; }
.entry:last-child { margin-bottom: 0; }

.entry-head {
  break-inside: avoid;
  page-break-inside: avoid;
  break-after: avoid;
  page-break-after: avoid;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-primary { font-weight: 700; font-size: 10.5pt; }
.entry-date {
  font-size: 9.5pt;
  color: #2b2b2b;
  white-space: nowrap;
  margin-left: 10pt;
  font-variant-numeric: tabular-nums;
}

.entry-org { font-size: 10pt; color: #3a4a5c; }
.entry-org .place { color: #5d6875; }

.entry-description { margin-top: 1.5pt; color: #2b2b2b; }
.entry-stack { font-style: italic; color: #4a5562; }
.entry-tech { margin-top: 1.5pt; font-size: 9.5pt; color: #4a5562; }
.entry-tech b { font-weight: 600; color: #3a4a5c; }

ul.bullets {
  list-style: none;
  margin: 2pt 0 0 0;
}

ul.bullets li {
  position: relative;
  padding-left: 10pt;
  margin-bottom: 1.5pt;
  break-inside: avoid;
  page-break-inside: avoid;
}

ul.bullets li::before {
  content: "\2013";
  position: absolute;
  left: 0;
  color: #5d6875;
}

/* --- Skills: label column and values, wrapped lines stay under the values --- */
.skills-grid {
  display: grid;
  grid-template-columns: max-content 1fr;
  column-gap: 12pt;
  row-gap: 2pt;
}
.skill-label { font-weight: 600; color: #12263f; white-space: nowrap; }

/* --- Publications --- */
.pub { margin-bottom: 4pt; break-inside: avoid; page-break-inside: avoid; }
.pub:last-child { margin-bottom: 0; }
.pub-title { font-weight: 600; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    {% set contact_parts = [] %}
    {% set detail_parts = [] %}
    {% for item in (header.contact_items or []) %}
      {% set text = item.text or '' %}
      {% if not item.url and ': ' in text %}
        {% set label, value = text.split(': ', 1) %}
        {% set _ = detail_parts.append('<span class="ci"><b>' ~ label ~ ':</b> ' ~ value ~ '</span>') %}
      {% elif item.url %}
        {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
        {% set _ = contact_parts.append('<a class="ci" href="' ~ href ~ '">' ~ text ~ '</a>') %}
      {% elif text %}
        {% set _ = contact_parts.append('<span class="ci">' ~ text ~ '</span>') %}
      {% endif %}
    {% endfor %}
    {% if contact_parts %}<div class="contact">{{ contact_parts | join('<span class="sep">·</span>') }}</div>{% endif %}
    {% if detail_parts %}<div class="details">{{ detail_parts | join('<span class="sep">·</span>') }}</div>{% endif %}
  </div>
  {% endif %}

  {% for sec in section_order %}
  {% if sec.key == 'summary' and summary %}
  <div class="section">
    <div class="section-title">{{ 'Profile' if sec.title == 'Summary' else sec.title }}</div>
    <div class="summary-text">{{ summary }}</div>
  </div>
  {% elif sec.key == 'experience' and experience %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    {% for job in experience %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-row">
          <span class="entry-primary">{{ job.title }}</span>
          <span class="entry-date">{{ job.date }}</span>
        </div>
        {% if job.company or job.location %}
        <div class="entry-org">{{ job.company }}{% if job.company and job.location %}<span class="place">, {{ job.location }}</span>{% elif job.location %}<span class="place">{{ job.location }}</span>{% endif %}</div>
        {% endif %}
      </div>
      {% if job.description %}<div class="entry-description">{{ job.description }}</div>{% endif %}
      {# a bullet starting "Tech:" is the role's stack line, printed under the bullets #}
      {% set plain = [] %}{% set tech = [] %}
      {% for bullet in (job.bullets or []) %}
        {% if bullet is string and bullet.startswith('Tech:') %}{% set _ = tech.append(bullet[5:].strip()) %}{% else %}{% set _ = plain.append(bullet) %}{% endif %}
      {% endfor %}
      {% if plain %}
      <ul class="bullets">
        {% for bullet in plain %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% for line in tech %}<div class="entry-tech"><b>Tech:</b> {{ line }}</div>{% endfor %}
    </div>
    {% endfor %}
  </div>
  {% elif sec.key == 'skills' and skills %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <div class="skills-grid">
      {% if skills is mapping %}
        {% for label, value in skills.items() %}
        <span class="skill-label">{{ label }}</span>
        <span class="skill-value">{{ value }}</span>
        {% endfor %}
      {% else %}
        {% for sk in skills %}
        <span class="skill-label">{{ sk.category }}</span>
        <span class="skill-value">{{ sk.items }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  {% elif sec.key == 'education' and education %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    {% for edu in education %}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-row">
          <span class="entry-primary">{{ edu.degree or edu.school }}</span>
          <span class="entry-date">{{ edu.years or edu.date }}</span>
        </div>
        {% if edu.degree and (edu.school or edu.location) %}
        <div class="entry-org">{{ edu.school }}{% if edu.school and edu.location %}<span class="place">, {{ edu.location }}</span>{% elif edu.location %}<span class="place">{{ edu.location }}</span>{% endif %}</div>
        {% elif edu.location %}
        <div class="entry-org"><span class="place">{{ edu.location }}</span></div>
        {% endif %}
      </div>
      {% if edu.description %}<div class="entry-description">{{ edu.description | bold }}</div>{% endif %}
      {% if edu.bullets %}
      <ul class="bullets">
        {% for bullet in edu.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% elif sec.key == 'projects' and projects %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    {% for project in projects %}
    <div class="entry">
      <div class="entry-head">
        <span class="entry-primary">{% if project.url %}<a href="{{ project.url }}">{{ project.name or project.title }}</a>{% else %}{{ project.name or project.title }}{% endif %}</span>{% if project.description %}<span class="entry-stack"> · {{ project.description }}</span>{% endif %}
      </div>
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% elif sec.key == 'publications' and publications %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    {% for pub in publications %}
    <div class="pub">
      {% if pub.name or pub.title %}<span class="pub-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name or pub.title }}</a>{% else %}{{ pub.name or pub.title }}{% endif %}</span>{% if pub.description %}. {% endif %}{% endif %}{% if pub.description %}{{ pub.description | bold }}{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endfor %}

</div>
</body>
</html>
