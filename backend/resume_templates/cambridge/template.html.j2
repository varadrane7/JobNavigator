<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- Resume</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0;
}

html, body {
  font-family: 'STIX Two Text', 'Georgia', 'Times New Roman', serif;
  font-size: 10pt;
  line-height: 1.16;
  color: #141414;
  background: #fff;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-variant-ligatures: none;
  -webkit-font-feature-settings: "liga" 0, "clig" 0, "dlig" 0;
  font-feature-settings: "liga" 0, "clig" 0, "dlig" 0;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.3in 0.45in 0.2in 0.45in;
  margin: 0 auto;
}

/* --- Header: two stacked left-aligned lines (name, then contact) --- */
.header { margin-bottom: 4pt; }

.header h1 {
  font-size: 16.5pt;
  font-weight: 700;
  letter-spacing: 0.2px;
  line-height: 1;
}

.header .title-line {
  font-size: 9.5pt;
  font-style: italic;
  color: #333;
  margin-top: 1pt;
}

.header .contact {
  font-size: 9pt;
  color: #222;
  margin-top: 2pt;
}

.header .contact a { color: #222; text-decoration: none; }
.header .contact .sep { margin: 0 4pt; color: #666; }

/* --- Section --- */
.section { margin-top: 3pt; }

.section-title {
  text-transform: uppercase;
  font-size: 10pt;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: #111;
  border-bottom: 1.1px solid #111;
  padding-bottom: 0.5pt;
  margin-bottom: 2pt;
}

/* --- Summary --- */
.summary-text {
  font-size: 10pt;
  line-height: 1.2;
  color: #222;
  text-align: justify;
  hyphens: none;
}

/* --- Entry list: level-1 filled bullet per job/degree/project, like \itemize --- */
ul.entry-list {
  list-style: disc;
  margin: 0 0 0 13pt;
}

ul.entry-list > li.entry,
ul.entry-list > li.edu-entry {
  margin-bottom: 2pt;
  padding-left: 1pt;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-primary { font-weight: 700; font-size: 10pt; }
.entry-company { font-weight: 400; font-style: italic; color: #333; }
.entry-meta {
  font-size: 9pt;
  font-style: italic;
  color: #222;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}

.entry-description {
  margin-top: 1pt;
  font-size: 9.5pt;
  color: #222;
  text-align: justify;
  hyphens: none;
}

.entry-primary a { color: inherit; text-decoration: none; }
.entry-desc-inline { font-weight: 400; font-size: 9.5pt; color: #222; }

/* Level-2 hollow-circle bullets for accomplishment lines, like \labelitemii */
ul.bullets {
  list-style: circle;
  margin: 1pt 0 0 13pt;
}

ul.bullets li {
  margin-bottom: 0.5pt;
  font-size: 9.5pt;
  line-height: 1.18;
  text-align: justify;
  hyphens: none;
  padding-left: 1pt;
}

/* --- Skills: hanging-indent grid so wrapped lines align under the value column --- */
.skills-grid {
  display: grid;
  grid-template-columns: max-content 1fr;
  column-gap: 14pt;
  row-gap: 1pt;
  font-size: 9.5pt;
}
.skill-label { font-weight: 700; white-space: nowrap; }
.skill-value { color: #222; }

/* --- Education --- */
.edu-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.edu-school { font-weight: 700; font-size: 10pt; }
.edu-location {
  font-size: 9pt;
  color: #222;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.edu-degree { font-style: italic; font-size: 9.5pt; color: #222; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    <div class="contact">
      {% set contact_parts = [] %}
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          {% set _ = contact_parts.append('<a href="' ~ href ~ '">' ~ item.text ~ '</a>') %}
        {% else %}
          {% set _ = contact_parts.append(item.text) %}
        {% endif %}
      {% endfor %}
      {{ contact_parts | join(' <span class="sep">|</span> ') }}
    </div>
  </div>
  {% endif %}

  {% for sec in section_order %}
  {% if sec.key == 'summary' and summary %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <div class="summary-text">{{ summary }}</div>
  </div>
  {% elif sec.key == 'experience' and experience %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <ul class="entry-list">
    {% for job in experience %}
    <li class="entry">
      <div class="entry-row">
        <span class="entry-primary">{{ job.title }}{% if job.company %}<span class="entry-company"> — {{ job.company }}</span>{% endif %}</span>
        <span class="entry-meta">{{ job.location }}{% if job.location and job.date %} &middot; {% endif %}{{ job.date }}</span>
      </div>
      {% if job.description %}
      <div class="entry-description">{{ job.description }}</div>
      {% endif %}
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
    </ul>
  </div>
  {% elif sec.key == 'skills' and skills %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <div class="skills-grid">
      {% if skills is mapping %}
        {% for label, value in skills.items() %}
        <span class="skill-label">{{ label }}</span>
        <span class="skill-value">{{ value }}</span>
        {% endfor %}
      {% else %}
        {% for sk in skills %}
        <span class="skill-label">{{ sk.category }}</span>
        <span class="skill-value">{{ sk.items }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  {% elif sec.key == 'education' and education %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <ul class="entry-list">
    {% for edu in education %}
    <li class="edu-entry">
      <div class="edu-row">
        <span class="edu-school">{{ edu.school }}{% if edu.degree %}<span class="edu-degree"> — {{ edu.degree }}</span>{% endif %}</span>
        <span class="edu-location">{{ edu.location }}</span>
      </div>
    </li>
    {% endfor %}
    </ul>
  </div>
  {% elif sec.key == 'projects' and projects %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <ul class="entry-list">
    {% for project in projects %}
    <li class="entry">
      <div class="entry-primary">{% if project.url %}<a href="{{ project.url }}">{{ project.name or project.title }}</a>{% else %}{{ project.name or project.title }}{% endif %}{% if project.description %}<span class="entry-desc-inline"> — {{ project.description }}</span>{% endif %}</div>
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
    </ul>
  </div>
  {% elif sec.key == 'publications' and publications %}
  <div class="section">
    <div class="section-title">{{ sec.title }}</div>
    <ul class="entry-list">
    {% for pub in publications %}
    <li class="entry">
      <div class="entry-primary">{{ pub.name or pub.title }}</div>
      {% if pub.description %}<div class="entry-description">{{ pub.description }}</div>{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% endfor %}

</div>
</body>
</html>
