<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ header.name }} — Cover Letter</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
@page { size: {{ 'letter' if page_format == 'letter' else 'A4' }}; margin: 0.75in 0.9in; }
html, body {
  font-family: 'STIX Two Text', 'Georgia', 'Times New Roman', serif;
  font-size: 11pt; line-height: 1.4; color: #141414; background: #fff;
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  font-variant-ligatures: none; font-feature-settings: "liga" 0, "clig" 0, "dlig" 0;
}
.page { width: {{ '8.5in' if page_format == 'letter' else '210mm' }}; padding: 0.75in 0.9in; margin: 0 auto; }
/* Same print rules as the other letter templates: @page carries the gutters, and the
   flow's trailing whitespace is dropped so the signature never lands on a blank page. */
@media print {
  .page { width: auto; padding: 0; margin: 0; }
  .body p:last-child { margin-bottom: 0; }
  .closing { break-after: avoid; }
}
.header { margin-bottom: 18pt; }
.header h1 { font-size: 16.5pt; font-weight: 700; letter-spacing: 0.2px; line-height: 1; }
.header .title-line { font-size: 9.5pt; font-style: italic; color: #333; margin-top: 1pt; }
.header .contact { font-size: 9pt; color: #222; margin-top: 2pt; }
.header .contact a { color: #222; text-decoration: none; }
.header .contact .sep { margin: 0 4pt; color: #666; }
.meta { margin-bottom: 14pt; }
.meta .date { margin-bottom: 12pt; }
.meta .recipient { line-height: 1.35; }
.greeting { margin-bottom: 10pt; }
.body p { margin-bottom: 10pt; text-align: justify; }
.closing { margin-top: 12pt; }
.signature { margin-top: 4pt; font-weight: 700; }
</style>
</head>
<body>
<div class="page">
  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    <div class="contact">
      {% set parts = [] %}
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          {% set _ = parts.append('<a href="' ~ href ~ '">' ~ item.text ~ '</a>') %}
        {% else %}
          {% set _ = parts.append(item.text) %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' <span class="sep">|</span> ') }}
    </div>
  </div>
  {% endif %}

  <div class="meta">
    {% if date %}<div class="date">{{ date }}</div>{% endif %}
    {% if recipient and (recipient.manager or recipient.company or recipient.address) %}
    <div class="recipient">
      {% if recipient.manager %}{{ recipient.manager }}<br>{% endif %}
      {% if recipient.company %}{{ recipient.company }}<br>{% endif %}
      {% if recipient.address %}{{ recipient.address }}{% endif %}
    </div>
    {% endif %}
  </div>

  {% if greeting %}<div class="greeting">{{ greeting }}</div>{% endif %}
  <div class="body">{% for para in (body_paragraphs or []) %}<p>{{ para | bold }}</p>{% endfor %}</div>
  {% if closing %}<div class="closing">{{ closing }}</div>{% endif %}
  {% if signature %}<div class="signature">{{ signature }}</div>{% endif %}
</div>
</body>
</html>
